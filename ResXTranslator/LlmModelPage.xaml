<?xml version="1.0" encoding="UTF-8" ?>
<controls:ModalSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:controls="clr-namespace:ResXTranslator.Controls"
                         x:Class="ResXTranslator.LlmModelPage"
                         x:ClassModifier="internal"
                         Title="Choose Model"
                         Shell.NavBarIsVisible="False">

    <Grid Padding="20,16,20,20"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" MinimumHeightRequest="32">
            <controls:ActionButton Text="Cancel"
                                   Prominence="Plain"
                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                   FontSize="13"
                                   Clicked="OnCancelClicked" />
            <Label x:Name="PageTitleLabel"
                   Grid.Column="1"
                   Text="Choose Model"
                   Style="{StaticResource StatusTitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <controls:ActionButton x:Name="RefreshButton"
                                   Grid.Column="2"
                                   Text="Refresh"
                                   Prominence="Plain"
                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                   FontSize="13"
                                   Clicked="OnRefreshClicked" />
        </Grid>

        <Border x:Name="ModelSearchWell"
                Grid.Row="1"
                Style="{StaticResource FieldWell}"
                MinimumHeightRequest="40">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <controls:SymbolImage Symbol="magnifyingglass"
                                      PointSize="13"
                                      Tint="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}"
                                      VerticalOptions="Center" />
                <Entry x:Name="ModelSearchEntry"
                       Grid.Column="1"
                       Placeholder="Search names, providers or model IDs"
                       FontSize="13"
                       ReturnType="Search"
                       Focused="OnSearchFocused"
                       Unfocused="OnSearchUnfocused"
                       TextChanged="OnSearchTextChanged"
                       SemanticProperties.Description="Search provider models" />
                <controls:ActionButton x:Name="ClearSearchButton"
                                       Grid.Column="2"
                                       Text="Clear"
                                       Prominence="Plain"
                                       Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                       FontSize="12"
                                       IsVisible="False"
                                       Clicked="OnClearSearchClicked"
                                       SemanticProperties.Description="Clear model search" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border x:Name="ManualModelWell" Style="{StaticResource FieldWell}" MinimumHeightRequest="40">
                <Entry x:Name="ManualModelEntry"
                       Placeholder="Exact model ID"
                       FontSize="13"
                       ReturnType="Done"
                       Completed="OnUseManualModelClicked"
                       Focused="OnManualModelFocused"
                       Unfocused="OnManualModelUnfocused"
                       TextChanged="OnManualModelTextChanged"
                       SemanticProperties.Description="Manual provider model ID" />
            </Border>
            <controls:ActionButton x:Name="UseManualModelButton"
                                   Grid.Column="1"
                                   Text="Test &amp; Use"
                                   Prominence="Plain"
                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                   FontSize="13"
                                   Clicked="OnUseManualModelClicked" />
        </Grid>

        <Label Grid.Row="3"
               Text="Choosing a model runs a small strict-schema test. Cloud providers may charge for it; successful tests are reused until the endpoint or model changes."
               Style="{StaticResource RowFooter}"
               Margin="6,0"
               LineBreakMode="WordWrap" />

        <Grid x:Name="CatalogNotice"
              Grid.Row="4"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              Margin="6,0"
              IsVisible="False">
            <controls:SymbolImage Symbol="exclamationmark.triangle.fill"
                                  PointSize="13"
                                  Tint="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                                  VerticalOptions="Center" />
            <Label x:Name="CatalogNoticeLabel"
                   Grid.Column="1"
                   Style="{StaticResource RowFooter}"
                   VerticalOptions="Center"
                   LineBreakMode="WordWrap" />
        </Grid>

        <Grid Grid.Row="5">
            <Border x:Name="ModelListCard" Style="{StaticResource Card}">
                <CollectionView x:Name="ModelList"
                                SelectionMode="Single"
                                SelectionChanged="OnModelSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto"
                                      RowSpacing="1"
                                      Padding="14,9"
                                      MinimumHeightRequest="72">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource RowTitle}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1"
                                           Text="{Binding Id}"
                                           Style="{StaticResource RowFooter}"
                                           LineBreakMode="MiddleTruncation" />
                                    <Label Grid.Row="2"
                                           Text="{Binding PriceDescription}"
                                           Style="{StaticResource RowFooter}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="3"
                                           Text="{Binding ReasoningDescription}"
                                           Style="{StaticResource RowFooter}"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="{Binding RequiresReasoning}" />
                                    <controls:SymbolImage Grid.Column="1"
                                                          Grid.RowSpan="4"
                                                          Symbol="checkmark"
                                                          PointSize="14"
                                                          Bold="True"
                                                          Tint="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                          VerticalOptions="Center"
                                                          Margin="12,0,0,0"
                                                          IsVisible="{Binding IsSelected}" />
                                </Grid>
                                <BoxView Style="{StaticResource RowSeparator}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <VerticalStackLayout x:Name="ModelState"
                                 Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="360"
                                 IsVisible="False">
                <ActivityIndicator x:Name="ModelActivity" IsVisible="False" IsRunning="False" />
                <controls:SymbolImage x:Name="ModelStateIcon"
                                      Symbol="magnifyingglass"
                                      PointSize="24"
                                      Tint="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}"
                                      HorizontalOptions="Center" />
                <Label x:Name="ModelStateTitle"
                       Style="{StaticResource StatusTitle}"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="ModelStateDetail"
                       Style="{StaticResource RowFooter}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</controls:ModalSheetPage>
