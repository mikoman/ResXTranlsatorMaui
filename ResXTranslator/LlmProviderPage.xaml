<?xml version="1.0" encoding="UTF-8" ?>
<controls:ModalSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:controls="clr-namespace:ResXTranslator.Controls"
                         x:Class="ResXTranslator.LlmProviderPage"
                         x:ClassModifier="internal"
                         Title="Choose Provider"
                         Shell.NavBarIsVisible="False">
    <Grid Padding="20,16,20,20" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" MinimumHeightRequest="32">
            <controls:ActionButton Text="Cancel"
                                   Prominence="Plain"
                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                   FontSize="13"
                                   Clicked="OnCancelClicked" />
            <Label Grid.Column="1"
                   Text="Choose Provider"
                   Style="{StaticResource StatusTitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <BoxView Grid.Column="2" WidthRequest="52" Opacity="0" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <CollectionView x:Name="ProviderList"
                            SelectionMode="Single"
                            SelectionChanged="OnProviderSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="14,10">
                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                <Label Grid.Row="1"
                                       Text="{Binding Detail}"
                                       Style="{StaticResource RowFooter}"
                                       LineBreakMode="WordWrap" />
                                <controls:SymbolImage Grid.Column="1"
                                                      Grid.RowSpan="2"
                                                      Symbol="checkmark"
                                                      PointSize="14"
                                                      Bold="True"
                                                      Tint="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                      VerticalOptions="Center"
                                                      IsVisible="{Binding IsSelected}" />
                            </Grid>
                            <BoxView Style="{StaticResource RowSeparator}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</controls:ModalSheetPage>
