<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ResXTranslator.Controls"
             x:Class="ResXTranslator.MainPage"
             Title="ResXTranslator"
             Shell.NavBarIsVisible="False">

    <!--
    THESIS: A .resx translator that reads as a macOS utility, not a form. It
    refuses the category default of a stacked column of identically-weighted
    buttons; the interface states what it knows about your file, and offers one
    action.
    OWN-WORLD: Apple's grouped-list vocabulary. #F2F2F7 / #1C1C1E ground, white /
    #2C2C2E rows in 10pt cards, hairline inset separators, SF Pro at system text
    sizes, SF Symbols, and one violet tint from #512BD4 used only on the primary
    action, the selected checkmark, the focus ring and the progress bar.
    STORY: The user sees a file or recursive RESX folder, an OpenRouter account,
    a model and a language; understands what will be written and where; presses
    Translate once; watches animated batch-by-batch progress; ends with a result
    they can reveal in Finder.
    FIRST VIEWPORT: A 648pt centred column in a 720 × 680pt utility window. No nav bar;
    the name lives in the title bar. SOURCE card, then OPENROUTER card, then the
    filled Translate button with both exports as plain tinted text. Credentials
    and the searchable catalog live in focused sheets, never inline clutter.
    FORM: The platform canon, taken deliberately because the brief pinned it.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, DESIGN.md, and every shipping raster carrying its
    provenance.
    -->

    <ScrollView x:Name="MainScrollView">
        <VerticalStackLayout Padding="0,26,0,32"
                             Spacing="22"
                             WidthRequest="648"
                             HorizontalOptions="Center">

            <!-- ============ SOURCE ============ -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Source" Style="{StaticResource SectionHeader}" />

                <Border x:Name="SourceCard" Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <DropGestureRecognizer AllowDrop="True"
                                               DragOver="OnSourceDragOver"
                                               DragLeave="OnSourceDragLeave"
                                               Drop="OnSourceDrop" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              Padding="14,11"
                              MinimumHeightRequest="44">

                            <controls:SymbolImage x:Name="SourceIcon"
                                                  Grid.Column="0"
                                                  Symbol="doc.badge.plus"
                                                  PointSize="19"
                                                  Tint="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                  VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label x:Name="SourceTitleLabel"
                                       Text="No file selected"
                                       Style="{StaticResource RowTitle}"
                                       LineBreakMode="MiddleTruncation" />
                                <Label x:Name="SourceSubtitleLabel"
                                       Text="RESX, Excel or CSV — or drag one here"
                                       Style="{StaticResource RowFooter}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- An explicit button, not a tappable row: this is the
                                 macOS convention for choosing a file, and unlike a
                                 bare gesture on a layout it is a real control. -->
                            <HorizontalStackLayout Grid.Column="2"
                                                   Spacing="2"
                                                   VerticalOptions="Center">
                                <controls:ActionButton x:Name="PickFileButton"
                                                       Text="Choose File…"
                                                       Prominence="Plain"
                                                       Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                       FontSize="13"
                                                       Clicked="OnFilePickerButtonClicked" />
                                <controls:ActionButton x:Name="PickFolderButton"
                                                       Text="Choose Folder…"
                                                       Prominence="Plain"
                                                       Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                       FontSize="13"
                                                       Clicked="OnFolderPickerButtonClicked"
                                                       SemanticProperties.Description="Choose a folder of RESX files" />
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView x:Name="SourceSeparator"
                                 Style="{StaticResource RowSeparator}"
                                 IsVisible="False" />

                        <Label x:Name="SourceDetailLabel"
                               Style="{StaticResource RowFooter}"
                               Padding="14,10"
                               LineBreakMode="TailTruncation"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ OPENROUTER ============ -->
            <VerticalStackLayout Spacing="0">
                <Label Text="OpenRouter" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                              ColumnSpacing="10"
                              Padding="14,10"
                              MinimumHeightRequest="44">
                            <Label Grid.Column="0"
                                   Text="Account"
                                   Style="{StaticResource RowTitle}"
                                   VerticalOptions="Center" />

                            <controls:SymbolImage x:Name="AccountIcon"
                                    Grid.Column="1"
                                                  Symbol="key.fill"
                                                  PointSize="14"
                                                  VerticalOptions="Center" />

                            <Label x:Name="AccountStatusLabel"
                                   Grid.Column="2"
                                   Text="Not connected"
                                   Style="{StaticResource RowValue}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />

                            <controls:ActionButton x:Name="ManageAccountButton"
                                                   Grid.Column="3"
                                                   Text="Manage…"
                                                   Prominence="Plain"
                                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                   FontSize="13"
                                                   Clicked="OnManageAccountClicked" />
                        </Grid>

                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              Padding="14,9"
                              MinimumHeightRequest="48">
                            <Label Text="Model"
                                   Style="{StaticResource RowTitle}"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label x:Name="ModelNameLabel"
                                       Text="Connect first"
                                       Style="{StaticResource RowValue}"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="ModelIdLabel"
                                       Style="{StaticResource RowFooter}"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="MiddleTruncation"
                                       IsVisible="False" />
                            </VerticalStackLayout>

                            <controls:ActionButton x:Name="ChooseModelButton"
                                                   Grid.Column="2"
                                                   Text="Choose…"
                                                   Prominence="Plain"
                                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                   FontSize="13"
                                                   Clicked="OnChooseModelClicked" />
                        </Grid>

                        <BoxView Style="{StaticResource RowSeparator}" />

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              Padding="14,9"
                              MinimumHeightRequest="48">
                            <Label Grid.Column="0"
                                   Text="Translate into"
                                   Style="{StaticResource RowTitle}"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="1"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label x:Name="LanguageNameLabel"
                                       Text="No language selected"
                                       Style="{StaticResource RowValue}"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="LanguageCodeLabel"
                                       Style="{StaticResource RowFooter}"
                                       HorizontalTextAlignment="End"
                                       IsVisible="False" />
                            </VerticalStackLayout>

                            <controls:ActionButton x:Name="ChooseLanguageButton"
                                                   Grid.Column="2"
                                                   Text="Choose…"
                                                   Prominence="Plain"
                                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                   FontSize="13"
                                                   Clicked="OnChooseLanguageClicked"
                                                   SemanticProperties.Description="Choose target language" />
                        </Grid>

                        <BoxView x:Name="UsageSeparator"
                                 Style="{StaticResource RowSeparator}"
                                 IsVisible="False" />

                        <Label x:Name="UsageLabel"
                               Style="{StaticResource RowFooter}"
                               Padding="14,10"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ ACTIONS ============ -->
            <VerticalStackLayout Spacing="4" Margin="0,2,0,0">
                <controls:ActionButton x:Name="TranslateButton"
                                       Text="Translate"
                                       Prominence="Filled"
                                       Accent="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       MinimumHeightRequest="34"
                                       MinimumWidthRequest="170"
                                       HorizontalOptions="Center"
                                       Clicked="OnTranslateButtonClicked" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <controls:ActionButton x:Name="ExportButton"
                                           Text="Export to Excel"
                                           Prominence="Plain"
                                           Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                           FontSize="13"
                                           Clicked="OnSaveToExcelButtonClicked" />
                    <controls:ActionButton x:Name="ExportCsvButton"
                                           Text="Export to CSV"
                                           Prominence="Plain"
                                           Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                           FontSize="13"
                                           Clicked="OnSaveToCsvButtonClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- ============ STATUS ============ -->
            <VerticalStackLayout x:Name="StatusBlock" Spacing="10" IsVisible="False">

                <!-- Hand-drawn progress: MAUI's ProgressBar maps to UIProgressView,
                     whose fixed intrinsic height ignores HeightRequest. -->
                <VerticalStackLayout x:Name="ProgressGroup" Spacing="7" IsVisible="False">
                    <Border HeightRequest="4"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ControlFillLight}, Dark={StaticResource ControlFillDark}}"
                            StrokeShape="RoundRectangle 2"
                            HorizontalOptions="Fill">
                        <Grid x:Name="ProgressAnimationTrack" IsClippedToBounds="True">
                            <Grid x:Name="ProgressTrack" ColumnDefinitions="0*,1*">
                                <BoxView Grid.Column="0"
                                         Color="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                            </Grid>
                            <BoxView x:Name="ProgressPulse"
                                     WidthRequest="76"
                                     HorizontalOptions="Start"
                                     Opacity="0.5"
                                     Color="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="ProgressLabel"
                               Grid.Column="0"
                               Style="{StaticResource StatusTitle}"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                        <Label x:Name="ElapsedTimeLabel"
                               Grid.Column="1"
                               Text="Elapsed 00:00"
                               Style="{StaticResource RowFooter}"
                               FontSize="12"
                               HorizontalTextAlignment="End"
                               VerticalTextAlignment="Center"
                               SemanticProperties.Description="Total operation elapsed time" />
                    </Grid>
                    <Label x:Name="ProgressDetailLabel"
                           Style="{StaticResource RowFooter}"
                           LineBreakMode="WordWrap"
                           MaxLines="6"
                           SemanticProperties.Description="Live translation request status" />
                    <controls:ActionButton x:Name="CancelTranslationButton"
                                           Text="Cancel Translation"
                                           Prominence="Plain"
                                           Accent="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                                           FontSize="12"
                                           HorizontalOptions="Start"
                                           IsVisible="False"
                                           Clicked="OnCancelTranslationClicked" />
                </VerticalStackLayout>

                <Grid x:Name="ResultGroup"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      IsVisible="False">
                    <controls:SymbolImage x:Name="ResultIcon"
                                          Grid.Column="0"
                                          PointSize="15"
                                          VerticalOptions="Start"
                                          Margin="0,1,0,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label x:Name="ResultTitleLabel" Style="{StaticResource StatusTitle}" />
                        <Label x:Name="ResultDetailLabel"
                               Style="{StaticResource RowFooter}"
                               LineBreakMode="WordWrap"
                               IsVisible="False" />
                        <VerticalStackLayout x:Name="ResultFileList" Spacing="2" IsVisible="False" />
                    </VerticalStackLayout>
                </Grid>

                <controls:ActionButton x:Name="RevealLogButton"
                                       Text="Open Diagnostics Log"
                                       Prominence="Plain"
                                       Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                       FontSize="11"
                                       HorizontalOptions="Start"
                                       Clicked="OnRevealLogClicked"
                                       SemanticProperties.Description="Open the redacted ResXTranslator diagnostics log" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
