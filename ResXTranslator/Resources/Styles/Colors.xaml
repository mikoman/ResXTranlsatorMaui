<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    <!-- ==========================================================
         Apple semantic tokens. Mirrors UIColor's systemGroupedBackground /
         label / separator families so light and dark are both first class.
         Eight-digit values are #AARRGGBB, which is XAML's order and the reverse
         of Apple's own #RRGGBBAA documentation — getting it backwards turns the
         neutral control fill into dark olive.
         AccentFill and AccentText are deliberately separate: #512BD4 gives
         7.9:1 under white text (correct as a filled button) but only ~2.2:1
         against the dark ground, so it cannot double as tinted text there.
         ========================================================== -->

    <Color x:Key="GroupedBackgroundLight">#F2F2F7</Color>
    <Color x:Key="GroupedBackgroundDark">#1C1C1E</Color>
    <Color x:Key="RowSurfaceLight">#FFFFFF</Color>
    <Color x:Key="RowSurfaceDark">#2C2C2E</Color>
    <Color x:Key="SeparatorLight">#C6C6C8</Color>
    <Color x:Key="SeparatorDark">#38383A</Color>

    <Color x:Key="LabelLight">#000000</Color>
    <Color x:Key="LabelDark">#FFFFFF</Color>
    <!-- Darkened from Apple's translucent secondaryLabel composite so 11–13pt
         text still clears 4.5:1 on both grouped and row surfaces. -->
    <Color x:Key="SecondaryLabelLight">#636366</Color>
    <Color x:Key="SecondaryLabelDark">#98989D</Color>
    <Color x:Key="TertiaryLabelLight">#C4C4C6</Color>
    <Color x:Key="TertiaryLabelDark">#5B5B5E</Color>

    <Color x:Key="ControlFillLight">#33787880</Color>
    <Color x:Key="ControlFillDark">#5C787880</Color>

    <Color x:Key="AccentFillLight">#512BD4</Color>
    <Color x:Key="AccentFillDark">#6B45E8</Color>
    <Color x:Key="AccentFillPressedLight">#4524BB</Color>
    <Color x:Key="AccentFillPressedDark">#7D5AEF</Color>
    <Color x:Key="AccentTextLight">#512BD4</Color>
    <Color x:Key="AccentTextDark">#9F86FF</Color>

    <Color x:Key="SuccessLight">#34C759</Color>
    <Color x:Key="SuccessDark">#30D158</Color>
    <Color x:Key="WarningLight">#FF9500</Color>
    <Color x:Key="WarningDark">#FF9F0A</Color>
    <Color x:Key="DangerLight">#C71F16</Color>
    <Color x:Key="DangerDark">#FF453A</Color>
</ResourceDictionary>
