<?xml version="1.0" encoding="UTF-8" ?>
<controls:ModalSheetPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         xmlns:controls="clr-namespace:ResXTranslator.Controls"
                         x:Class="ResXTranslator.LlmConnectionPage"
                         x:ClassModifier="internal"
                         Shell.NavBarIsVisible="False">
    <Grid Padding="20,16,20,22" RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="Auto,*,Auto" MinimumHeightRequest="32">
            <controls:ActionButton Text="Cancel"
                                   Prominence="Plain"
                                   Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                   FontSize="13"
                                   Clicked="OnCancelClicked" />
            <Label x:Name="PageTitleLabel"
                   Grid.Column="1"
                   Style="{StaticResource StatusTitle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <BoxView Grid.Column="2" WidthRequest="52" Opacity="0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="500" HorizontalOptions="Fill">
                <VerticalStackLayout x:Name="ConnectedSection" Spacing="0">
                    <Label Text="Connection" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="14,12">
                                <controls:SymbolImage x:Name="StoredIcon"
                                                      Symbol="checkmark.circle.fill"
                                                      PointSize="18"
                                                      VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label x:Name="StoredTitleLabel" Style="{StaticResource RowTitle}" />
                                    <Label x:Name="StoredDetailLabel"
                                           Style="{StaticResource RowFooter}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource RowSeparator}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Padding="8,3">
                                <controls:ActionButton Text="Edit…"
                                                       Prominence="Plain"
                                                       Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                       FontSize="13"
                                                       Clicked="OnEditClicked" />
                                <controls:ActionButton x:Name="RemoveButton"
                                                       Grid.Column="1"
                                                       Text="Remove Key"
                                                       Prominence="Plain"
                                                       Accent="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                                                       FontSize="13"
                                                       Clicked="OnRemoveClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="EditorSection" Spacing="12">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Endpoint" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid Padding="14,9">
                                <Border x:Name="EndpointWell" Style="{StaticResource FieldWell}">
                                    <Entry x:Name="EndpointEntry"
                                           FontSize="13"
                                           Keyboard="Url"
                                           ReturnType="Next"
                                           Focused="OnEndpointFocused"
                                           Unfocused="OnEndpointUnfocused"
                                           TextChanged="OnEditorChanged"
                                           SemanticProperties.Description="LLM provider endpoint URL" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ApiKeySection" Spacing="0">
                        <Label Text="API key" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="14,9">
                                <Border x:Name="KeyWell" Style="{StaticResource FieldWell}">
                                    <Entry x:Name="KeyEntry"
                                           IsPassword="True"
                                           FontSize="13"
                                           ReturnType="Done"
                                           Completed="OnConnectClicked"
                                           Focused="OnKeyFocused"
                                           Unfocused="OnKeyUnfocused"
                                           TextChanged="OnEditorChanged"
                                           SemanticProperties.Description="Provider API key" />
                                </Border>
                                <controls:ActionButton x:Name="RevealButton"
                                                       Grid.Column="1"
                                                       Text="Show"
                                                       Prominence="Plain"
                                                       Accent="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}"
                                                       FontSize="13"
                                                       Clicked="OnRevealClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="SecurityDetailLabel"
                           Style="{StaticResource RowFooter}"
                           Margin="14,-4,14,0"
                           LineBreakMode="WordWrap" />

                    <controls:ActionButton x:Name="ConnectButton"
                                           Text="Connect"
                                           Prominence="Filled"
                                           Accent="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           MinimumWidthRequest="150"
                                           HorizontalOptions="Center"
                                           Clicked="OnConnectClicked" />
                </VerticalStackLayout>

                <Grid x:Name="ConnectionError"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      Margin="14,-6,14,0"
                      IsVisible="False">
                    <controls:SymbolImage Symbol="exclamationmark.triangle.fill"
                                          PointSize="14"
                                          Tint="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                                          VerticalOptions="Start" />
                    <Label x:Name="ConnectionErrorLabel"
                           Grid.Column="1"
                           Style="{StaticResource RowFooter}"
                           TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                           LineBreakMode="WordWrap" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</controls:ModalSheetPage>
